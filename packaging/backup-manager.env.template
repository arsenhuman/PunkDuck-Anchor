#  =====================================================================
#   PunkDuck Backup Manager - settings for this machine
#  =====================================================================
#
#   Fill in the lines marked  <-- FILL IN.
#   Everything else can stay as it is. Empty lines are filled in by the
#   installer.
#
#   Write the value right after "=", without spaces or quotes.
#   If a value contains a #, put it in single quotes:  SQL_PASSWORD='ab#12'
#
#   When you are done: save (Ctrl+S), close Notepad, go back to PowerShell
#   and press Enter.
#  =====================================================================


#  ---------------------------------------------------------------------
#   1. DATABASES TO BACK UP                                   <-- FILL IN
#  ---------------------------------------------------------------------
#   Database names exactly as shown in SSMS, separated by commas.
#   Example:  SQL_DATABASES=Sales,Stock

SQL_DATABASES=


#  ---------------------------------------------------------------------
#   2. SQL SERVER INSTANCE                       <-- FILL IN if not default
#  ---------------------------------------------------------------------
#   Empty  = the default instance (service "SQL Server (MSSQLSERVER)").
#   Otherwise the name in brackets, e.g. "SQL Server (SQLEXPRESS)" ->
#   SQL_INSTANCE=SQLEXPRESS. The installer lists the instances it finds.

SQL_INSTANCE=


#  ---------------------------------------------------------------------
#   3. SQL LOGIN FOR BACKUPS                                    optional
#  ---------------------------------------------------------------------
#   Leave BOTH empty: the installer creates a login "backup_user" with a
#   random password and writes both here (recommended).
#   Or enter an existing SQL login and its password to use that one.

SQL_USER=
SQL_PASSWORD=


#  ---------------------------------------------------------------------
#   4. CLIENT'S GOOGLE ACCOUNT                                <-- FILL IN
#  ---------------------------------------------------------------------
#   The client's own Gmail. Backups go to THEIR Google Drive.

GOOGLE_EMAIL=


#  ---------------------------------------------------------------------
#   5. MONITORING                                             <-- FILL IN
#  ---------------------------------------------------------------------
#   Ping URL of this client's check on Healthchecks.io,
#   e.g. https://hc-ping.com/1234abcd-...

HEALTHCHECK_URL=


#  ---------------------------------------------------------------------
#   6. SCHEDULE AND HOW LONG TO KEEP BACKUPS                    optional
#  ---------------------------------------------------------------------
#   BACKUP_TIME  daily start time, 24-hour HH:MM
#   KEEP_LAST    always keep at least this many newest backups
#   KEEP_DAYS    and keep every backup younger than this many days

BACKUP_TIME=02:00
KEEP_LAST=7
KEEP_DAYS=30


#  ---------------------------------------------------------------------
#   7. FILLED IN BY THE INSTALLER - leave empty
#  ---------------------------------------------------------------------
#   BACKUP_ENCRYPTION_KEY  generated and shown ONCE: store it in the
#                          company password manager. Never change it.
#   SQL_BACKUP_DIR         SQL Server's own backup folder.

BACKUP_ENCRYPTION_KEY=
SQL_BACKUP_DIR=


#  ---------------------------------------------------------------------
#   8. ADVANCED - normally do not change
#  ---------------------------------------------------------------------
#   SQL_HOST     SQL Server must run on this machine.
#   SQL_PORT     TCP port. For a named instance, a port other than 1433
#                connects to it directly instead of via SQL Browser.
#   SERVER_NAME  folder name on Google Drive (empty = computer name).

SQL_HOST=localhost
SQL_PORT=1433
SERVER_NAME=
